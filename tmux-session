#!/usr/bin/env bash
set -e

DIR=""
NAME=""
CONFIG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir|-d)
      DIR="$2"
      shift 2
      ;;
    --name|-n)
      NAME="$2"
      shift 2
      ;;
    --config|-c)
      CONFIG="$2"
      shift 2
      ;;
    *)
      echo "Usage: tmux-session [--dir <directory>] [--name <session-name>] [--config <config-name>]" >&2
      exit 1
      ;;
  esac
done

DIR="${DIR:-$PWD}"
SESSION="${NAME:-$(basename "$PWD")}"
CONFIG="${CONFIG:-$SESSION}"

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  tmux attach-session -t "=$SESSION"
  exit 0
fi

TMUXINATOR_CONFIG="$HOME/.config/tmuxinator/$CONFIG.yml"

if [[ -f "$TMUXINATOR_CONFIG" ]]; then
  tmuxinator start "$CONFIG" --name="$SESSION" -- "$DIR"
else
  tmux new-session -s "$SESSION" -c "$DIR"
fi
